---
export interface Props {
  variant?: "default" | "compact";
}

const { variant = "default" } = Astro.props;
---

<div
  class={variant === "default"
    ? "newsletter-box my-8 rounded-lg border border-gray-200 dark:border-gray-700 bg-transparent p-6 sm:p-8"
    : "newsletter-compact mt-6"}
>
  {variant === "default" && (
    <p class="mb-4 text-sm text-gray-900 dark:text-gray-100">
      If you want an email when I publish something new, leave your address here.
    </p>
  )}

  <form
    action="https://buttondown.com/api/emails/embed-subscribe/astroza"
    method="post"
    target="_blank"
    class="embeddable-buttondown-form flex flex-col gap-3 sm:flex-row"
  >
    <label for="bd-name" class="sr-only">Your Name</label>
    <input
      type="text"
      name="name"
      id="bd-name"
      placeholder="Your Name"
      class="flex-1 rounded-md border border-gray-300 bg-white px-4 py-2 text-gray-900 placeholder-gray-600 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-accent dark:border-gray-600 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-400"
    />
    <label for="bd-email" class="sr-only">Your Email</label>
    <input
      type="email"
      name="email"
      id="bd-email"
      placeholder="Your Email"
      required
      class="flex-1 rounded-md border border-gray-300 bg-white px-4 py-2 text-gray-900 placeholder-gray-600 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-accent dark:border-gray-600 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-400"
    />
    <button
      type="submit"
      class="whitespace-nowrap rounded-md bg-[#0a6fbf] px-6 py-2 font-semibold transition-colors hover:bg-[#095fa6] focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
      style="color: white;"
    >
      Subscribe
    </button>
  </form>

  {variant === "default" && (
    <p class="mt-3 text-xs text-gray-900 dark:text-gray-100">
      Occasional updates about posts, projects, and experiments.
    </p>
  )}
</div>

<style>
  @media (max-width: 640px) {
    .newsletter-box {
      margin-left: -1rem;
      margin-right: -1rem;
      border-radius: 0;
    }
  }
</style>
